{
  "name": "celadon-internal-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "ateneoceladon.com/internal*", "zone_name": "ateneoceladon.com" }
  ],
  "vars": {
    // Not secret — client IDs are public by design (they end up in browser
    // redirect URLs). Replace with the real value from Google Cloud Console.
    "GOOGLE_CLIENT_ID": "885883189559-k8pq7p1d5en2joudl6jorkpreu8kq2r6.apps.googleusercontent.com",
    // Comma-separated. GOOGLE_CLIENT_SECRET and COOKIE_SECRET are set via
    // `wrangler secret put` instead — never committed here.
    "ALLOWED_EMAIL_DOMAINS": "student.ateneo.edu,ateneo-celadon.org"
  },
  "kv_namespaces": [
    {
      "binding": "MEMBERS",
      // Create once with: npx wrangler kv namespace create MEMBERS
      // — paste the id it prints here. Populate/refresh it from the Sheet's
      // `members` tab with: npm run sync:members (see scripts/sync-members.mjs).
      "id": "ceafb68d28b2450ab985a361c97ef5a5"
    }
  ]
}
